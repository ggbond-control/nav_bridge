{
  mode: "router",
  queries_default_timeout: 120000,
  listen: {
    endpoints: [
      "tcp/0.0.0.0:7447"
    ]
  },
  connect: {
    endpoints: [
      "tcp/192.168.168.100:7447"  // 指向 Humble 机器 IP
    ]
  },
  scouting: {
    multicast: {
      enabled: false               // 关闭组播探测，避免 127.0.0.1 冲突
    },
    gossip: {
      enabled: false               // 关闭 Gossip
    }
  },
  adminspace: {
    enabled: true                  // 允许本地 Client 发现此 Router
  }
}
