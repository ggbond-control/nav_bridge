{
  mode: "router",
  queries_default_timeout: 120000,
  listen: {
    endpoints: [
      "tcp/0.0.0.0:7447"
    ]
  },
  connect: {
    endpoints: [
      "tcp/192.168.168.100:7447"
    ]
  },
  scouting: {
    multicast: {
      enabled: false
    },
    gossip: {
      enabled: false
    }
  },
  adminspace: {
    enabled: true
  }
}
