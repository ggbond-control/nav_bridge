{
  "mode": "client",
  "queries_default_timeout": 180000,
  "transport": {
    "shared_memory": {
      "enabled": false
    }
  },
  "connect": {
    "endpoints": [
      "tcp/127.0.0.1:7447"
    ]
  },
  "listen": {
    "endpoints": []
  },
  "scouting": {
    "multicast": {
      "enabled": false,
      "listen": false
    },
    "gossip": {
      "enabled": false
    }
  }
}
