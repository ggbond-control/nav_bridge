{
  queries_default_timeout: 120000,
  transport: {
    shared_memory: {
      enabled: false
    }
  },
  connect: {
    endpoints: [
      "tcp/127.0.0.1:7447"        // 连接本机 Router
    ]
  },
  scouting: {
    // All ROS sessions use the explicit local router connection above.
    // Disable peer multicast scouting to avoid locator-less self announcements.
    multicast: {
      enabled: false
    },
    gossip: {
      enabled: false
    }
  }
}
